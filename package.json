{
  "name": "synthetic-data-generator",
  "version": "1.0.0",
  "description": "GDPR-compliant synthetic data generator for testing environments",
  "main": "dist/index.js",
  "bin": {
    "synthetic-data-gen": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "benchmark": "vitest run --testNamePattern=benchmark",
    "generate": "node dist/cli.js"
  },
  "keywords": [
    "synthetic-data",
    "gdpr",
    "privacy",
    "testing",
    "prisma",
    "faker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
